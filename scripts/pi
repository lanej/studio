#!/bin/sh
set -eu
package=$(CDPATH='' cd -P -- "${0%/*}/.." && pwd)
if ! command -v bun >/dev/null 2>&1; then
    printf '%s\n' "Studio requires Bun on PATH; install a version satisfying engines.bun in $package/package.json." >&2
    exit 1
fi
bun --no-env-file "--config=$package/resources/bunfig.toml" "$package/scripts/runtime.mjs"
exec bun --no-env-file "--config=$package/resources/bunfig.toml" "$package/node_modules/@earendil-works/pi-coding-agent/dist/cli.js" "$@"
