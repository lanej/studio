#!/bin/sh
# Run Studio with the environment's shared Bun runtime.
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher")
    case $target in
        /*) launcher=$target ;;
        *) launcher=${launcher%/*}/$target ;;
    esac
done
if ! package=$(CDPATH='' cd -P -- "${launcher%/*}/.." && pwd); then
    printf '%s\n' 'Could not locate the Studio package.' >&2
    exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
    printf '%s\n' "Studio requires Bun on PATH; install a version satisfying engines.bun in $package/package.json." >&2
    exit 1
fi
bun --no-env-file "--config=$package/resources/bunfig.toml" "$package/scripts/runtime.mjs"
exec bun --no-env-file "--config=$package/resources/bunfig.toml" "$package/cli.ts" "$@"
