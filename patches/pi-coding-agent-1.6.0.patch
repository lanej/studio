+export const DEFAULT_THINKING_LABEL = "\u{F09D1}"; // Nerd Fonts: nf-md-brain
+// Keep prose readable in wide lead consoles while letting Pi lay out the original Markdown.
+class ExpandedThinkingBlock extends Markdown {
+    constructor(text, outputPad, markdownTheme, transform) {
+        super(text, 0, 0, markdownTheme, { color: (value) => theme.fg("text", value) }, { transform });
