+    render(width) {
+        const padding = Math.min(this.outputPad, Math.max(0, Math.floor((width - 1) / 2)));
+        const available = width - 2 * padding;
+        // Reserve the marker before Markdown reflow so its first row keeps its full text.
+        const marker = available >= 5 ? "▾ " + DEFAULT_THINKING_LABEL + " " : available >= 2 ? "▾" : "";
+        const markerWidth = visibleWidth(marker);
+        const body = super.render(Math.max(1, Math.min(88, available - markerWidth)));
+        if (body.length === 0 || available <= 0)
+            return [];
+        const first = body.findIndex((line) => stripTerminalSequences(line).trim().length > 0);
+        const margin = " ".repeat(padding);
+        const heading = theme.fg("thinkingText", marker); // The trailing cell leaves room for Kitty's Nerd Font icon.
+        const rail = markerWidth >= 2 ? " ".repeat(markerWidth - 2) + theme.fg("borderMuted", "│") + " " : " ".repeat(markerWidth);
