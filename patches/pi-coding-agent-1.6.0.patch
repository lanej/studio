+            return [];
+        const first = body.findIndex((line) => stripTerminalSequences(line).trim().length > 0);
+        const margin = " ".repeat(padding);
+        const heading = theme.fg("thinkingText", marker); // The trailing cell leaves room for Kitty's Nerd Font icon.
+        const rail = markerWidth >= 2 ? " ".repeat(markerWidth - 2) + theme.fg("borderMuted", "│") + " " : " ".repeat(markerWidth);
