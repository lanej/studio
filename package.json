{
  "name": "@lanej/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "scripts": {
    "studio": "scripts/studio",
    "test": "bun test tests/",
    "test:beads-native": "bun acceptance/beads-control.ts",
    "test:pi-native": "bun acceptance/pi-models.ts && bun acceptance/pi-resources.ts && bun test ./acceptance/model-tools.ts",
    "format": "bun scripts/check-typescript.mjs fmt",
    "check": "bun scripts/check-typescript.mjs all",
    "lint": "bun scripts/check-typescript.mjs lint",
    "typecheck": "bun scripts/check-typescript.mjs typecheck",
    "quality:tools": "bun scripts/check-typescript.mjs tools",
    "audit": "bun scripts/check-typescript.mjs audit",
    "test:delegation-native": "bun acceptance/delegation.ts",
    "generate:zellij": "bun scripts/generate-zellij.mjs",
    "check:zellij": "bun scripts/generate-zellij.mjs --check",
    "check:build": "bun scripts/check-build.mjs",
    "install:local": "bun scripts/lifecycle.mjs build",
    "test:local": "bun acceptance/local-run.ts",
    "configure": "python3 scripts/configure.py .",
    "test:terminal": "uv run --script acceptance/terminal.py",
    "test:socrates-ui": "uv run --script acceptance/socrates-status.py",
    "test:standalone": "python3 scripts/test-standalone.py",
    "check:beads-api": "bun --bun node_modules/.bin/openapi-typescript vendor/task-runtime/api/beads-1.3.4.yaml -o vendor/task-runtime/generated/beads.ts --check",
    "test:lsp-native": "bun acceptance/lsp.ts",
    "test:runtime-beads-native": "bun acceptance/runtime-beads.ts",
    "test:runtime-worker-native": "bun acceptance/runtime-worker.ts",
    "test:verification-native": "bun acceptance/verification-sandbox.ts",
    "test:git-boundary-native": "bun acceptance/git-boundary.ts",
    "test:activation-native": "bun acceptance/activation.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@lanej/task-runtime": "file:./vendor/task-runtime",
    "@lumis-sh/wasm-json": "0.26.7",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@tintinweb/pi-subagents": "0.26.2",
    "commander": "^14.0.0",
    "pi-codex-tools": "0.4.2",
    "pi-git-diff": "0.1.1",
    "zod": "^4.0.0",
    "@lanej/pi-components": "file:./vendor/pi-components",
    "diff": "8.0.4",
    "lovely-mermaid": "0.3.3",
    "smol-toml": "1.9.1",
    "vscode-languageserver-protocol": "3.18.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "bun-types": "1.4.5",
    "minimatch": "11.0.3",
    "openapi-typescript": "7.13.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "undici": "8.12.4"
  },
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.6.0": "patches/pi-coding-agent-1.6.0.patch",
    "@earendil-works/pi-tui@1.6.0": "patches/pi-tui-right-column.patch",
    "pi-codex-tools@0.4.2": "patches/pi-codex-tools-0.4.2.patch"
  }
}
